# --- NerdCommand.AI JARVIS (Phase 1) configuration ---
# Copy to .env and adjust. In this phase the app runs with the "echo" model
# provider by default, so no API key is required to exercise the full
# orchestration pipeline.

# General
JARVIS_DEBUG=1

# Model router
# "echo"   -> no-key deterministic provider (default)
# "openai" -> any OpenAI-compatible API (set key + base URL below)
JARVIS_MODEL_PROVIDER=echo
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_MODEL_FAST=gpt-4o-mini
JARVIS_MODEL_REASONING=gpt-4o
JARVIS_MODEL_CODE=gpt-4o-mini

# Directories (defaults point into the repo)
JARVIS_MANIFESTS_DIR=agents/manifests
JARVIS_PROMPTS_DIR=agents/prompts

# Store (Phase 1: memory; later: postgres)
JARVIS_STORE_BACKEND=memory
